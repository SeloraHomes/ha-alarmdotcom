# Home Assistant SSH target for `just deploy` / `just deploy-no-restart`
# Copy this file to .env and adjust to your setup.
HA_HOST=root@192.168.x.x
HA_PORT=22

# Override if your HA config lives somewhere other than ~/config
# (e.g. /config on the official SSH add-on).
#HA_PATH=/config/custom_components/
